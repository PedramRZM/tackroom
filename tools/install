#!/usr/bin/env python3
"""Download and run tackroom from one GitHub commit. Pass --help for installer options."""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

REPO = 'PedramRZM/tackroom'
API = 'https://api.github.com'
RAW = 'https://raw.githubusercontent.com'


def fetch(url):
    request = urllib.request.Request(url, headers={'User-Agent': 'tackroom-bootstrap'})
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read(2 * 1024 * 1024 + 1)
        if len(data) > 2 * 1024 * 1024:
            raise ValueError('bootstrap download too large')
        return data


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    parser.add_argument('--ref', default='main')
    args, rest = parser.parse_known_args(argv)
    try:
        sha = args.ref
        if not re.fullmatch(r'[0-9a-f]{40}', sha):
            data = json.loads(fetch(f'{API}/repos/{REPO}/commits/{urllib.parse.quote(sha, safe="")}'))
            sha = data.get('sha', '')
        if not re.fullmatch(r'[0-9a-f]{40}', sha):
            raise ValueError('GitHub did not return a commit SHA')
        print(f'Tackroom source: {REPO}@{sha}', flush=True)
        installer = fetch(f'{RAW}/{REPO}/{sha}/tools/setup')
        # No writes to the application until the pinned installer has fetched/validated its files.
        with tempfile.TemporaryDirectory(prefix='tackroom-bootstrap-') as directory:
            path = Path(directory) / 'setup'
            path.write_bytes(installer)
            return subprocess.run([sys.executable, str(path), *rest, '--remote', '--ref', sha]).returncode
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f'tackroom: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
