#!/usr/bin/env python3
"""Build/check this repository's dogfooding outputs from the agent-neutral template."""
import argparse
import importlib.machinery
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / 'template'
setup = importlib.machinery.SourceFileLoader('tackroom_setup', str(ROOT / 'tools/setup')).load_module()


def outputs(template):
    return setup.build_catalog(setup.inventory(template), lambda rel: (template / rel).read_bytes())


def reconcile(root, entries, write):
    stale = []
    for rel, (kind, value) in entries.items():
        path = root / rel
        matches = (path.is_symlink() and os.readlink(path) == value) if kind == 'link' else (
            path.is_file() and not path.is_symlink() and path.read_text() == value)
        if matches:
            continue
        stale.append(rel)
        if write:
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.is_symlink() or path.is_file():
                path.unlink()
            if path.exists():
                raise ValueError(f'refusing to replace directory: {path}; migrate it explicitly first')
            if kind == 'link':
                path.symlink_to(value)
            else:
                path.write_text(value)
    return stale


def dogfood_entries(template):
    catalog, generated = outputs(template)
    entries = {rel: ('file', data.decode()) for rel, data in generated.items()
               if rel.startswith(('.claude/', '.codex/agents/')) or rel == 'CLAUDE.md'}
    entries['.agents/skills'] = ('link', '../template/.agents/skills')
    for name in catalog['skills']:
        entries[f'.claude/skills/{name}'] = ('link', f'../../.agents/skills/{name}')
    entries['.agents/hooks'] = ('link', '../template/.agents/hooks')
    entries['.agents/briefs'] = ('link', '../template/.agents/briefs')
    entries['.claude/hooks'] = ('link', '../.agents/hooks')
    for rel in ('.agents/README.md', 'scripts/agent/next-task', 'scripts/agent/claude-with',
                'scripts/agent/keys.example', 'scripts/agent/ratchet', 'scripts/agent/github-labels'):
        entries[rel] = ('link', os.path.relpath(template / rel, (ROOT / rel).parent))
    return entries


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--write', action='store_true', help='refresh generated repository outputs; default check only')
    parser.add_argument('--dogfood', action='store_true', help='compatibility alias; outputs always target this repo')
    args = parser.parse_args()
    stale = reconcile(ROOT, dogfood_entries(TEMPLATE), args.write)
    if stale and not args.write:
        raise ValueError('stale generated files: ' + ', '.join(stale))
    print('Agent-neutral template and generated dogfooding outputs: ' + ('refreshed' if args.write else 'current'))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError) as exc:
        raise SystemExit(str(exc))
