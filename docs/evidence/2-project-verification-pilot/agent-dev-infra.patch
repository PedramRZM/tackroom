@@ -0,0 +1,130 @@
+"""Run the public readiness command; replace only the external Coder executable."""
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from datetime import datetime
+
+
+ROOT = Path(__file__).resolve().parents[1]
+WORKSPACES = [{
+    "name": "pilot-workspace", "template_name": "workspace-container",
+    "outdated": False, "health": {"healthy": True},
+    "provider_note": "PRIVATE-FIXTURE-ONLY",
+    "latest_build": {
+        "status": "running", "template_version_name": "pilot-v1",
+        "resources": [{"agents": [{
+            "status": "connected", "lifecycle_state": "ready",
+            "health": {"healthy": True},
+        }]}],
+    },
+}]
+
+
+class ReadinessProcessTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory(prefix="readiness-pilot-")
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        self.state = self.root / "state.json"
+        self.calls = self.root / "calls.jsonl"
+        executable = self.root / "coder"
+        executable.write_text("#!" + sys.executable + "\n" + '''
+import json
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parent
+args = sys.argv[1:]
+with (root / "calls.jsonl").open("a") as log:
+    log.write(json.dumps(args) + "\\n")
+if args not in (["list", "-o", "json"], ["list", "-o", "json", "--all"]):
+    print("Fixture refuses non-list operations", file=sys.stderr)
+    sys.exit(97)
+state = json.loads((root / "state.json").read_text())
+print(state["stdout"], end="")
+print(state["stderr"], end="", file=sys.stderr)
+sys.exit(state["exit"])
+''')
+        executable.chmod(0o700)
+        self.seed()
+
+    def seed(self, workspaces=None, *, raw=None, stderr="", code=0):
+        payload = WORKSPACES if workspaces is None else workspaces
+        self.state.write_text(json.dumps({
+            "stdout": json.dumps(payload) if raw is None else raw,
+            "stderr": stderr, "exit": code,
+        }))
+
+    def run_probe(self, *args):
+        before = self.state.read_bytes()
+        result = subprocess.run(
+            [sys.executable, str(ROOT / "tools/coder_readiness.py"), *args],
+            cwd=self.root,
+            env={"PATH": str(self.root), "LANG": "C.UTF-8",
+                 "PYTHONDONTWRITEBYTECODE": "1"},
+            capture_output=True, text=True, timeout=10, check=False,
+        )
+        self.assertEqual(self.state.read_bytes(), before, "read must preserve provider state")
+        self.assertNotIn("PRIVATE-FIXTURE-ONLY", result.stdout + result.stderr)
+        return result
+
+    def successful_report(self, result):
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stderr, "")
+        report = json.loads(result.stdout)
+        self.assertEqual(report["fleet_capacity"], "unknown")
+        self.assertIs(report["dispatch_authorized"], False)
+        self.assertIsNotNone(datetime.fromisoformat(report["observed_at"]).tzinfo)
+        self.assertEqual(len(report["workspaces"]), 1)
+        return report
+
+    def test_ready_read_is_observation_not_dispatch_permission(self):
+        report = self.successful_report(self.run_probe())
+        self.assertEqual(report["scope"], "current-user")
+        self.assertEqual(report["workspaces"], [{
+            "workspace": "pilot-workspace", "template": "workspace-container",
+            "version": "pilot-v1", "outdated": False, "observation": "runtime-ready",
+        }])
+        self.assertEqual(json.loads(self.calls.read_text()), ["list", "-o", "json"])
+
+    def test_all_scope_remains_visible_only_and_reports_version_mismatch(self):
+        self.seed(stderr="version mismatch: PRIVATE-FIXTURE-ONLY")
+        report = self.successful_report(self.run_probe("--all"))
+        self.assertEqual(report["scope"], "all-visible-to-current-user")
+        self.assertIs(report["client_server_version_mismatch"], True)
+        self.assertEqual(json.loads(self.calls.read_text()), ["list", "-o", "json", "--all"])
+
+    def test_unhealthy_state_and_reseed_restore_readiness(self):
+        original = self.state.read_bytes()
+        unhealthy = copy.deepcopy(WORKSPACES)
+        unhealthy[0]["health"]["healthy"] = False
+        self.seed(unhealthy)
+        report = self.successful_report(self.run_probe())
+        self.assertEqual(report["workspaces"][0]["observation"], "runtime-not-ready")
+        self.seed()
+        self.assertEqual(self.state.read_bytes(), original)
+        reset_report = self.successful_report(self.run_probe())
+        self.assertEqual(reset_report["workspaces"][0]["observation"], "runtime-ready")
+
+    def test_denied_provider_read_fails_without_echoing_raw_output(self):
+        self.seed(raw="PRIVATE-FIXTURE-ONLY", stderr="PRIVATE-FIXTURE-ONLY", code=13)
+        result = self.run_probe("--all")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("Coder read failed or returned an unsupported response.", result.stderr)
+        self.assertEqual(json.loads(self.calls.read_text()), ["list", "-o", "json", "--all"])
+
+    def test_malformed_provider_response_fails_without_echoing_raw_output(self):
+        self.seed(raw="PRIVATE-FIXTURE-ONLY not JSON")
+        result = self.run_probe()
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("Coder read failed or returned an unsupported response.", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
